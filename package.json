{
  "name": "website-change-monitor",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0 --port 3000",
    "dev:api": "tsx watch src/server/api.ts",
    "dev:worker": "tsx watch src/server/worker.ts",
    "dev:scheduler": "tsx watch src/server/scheduler.ts",
    "dev:stack": "node scripts/dev-stack.mjs",
    "build": "npm run typecheck && tsc -p tsconfig.server.build.json && next build",
    "start": "node build/server/api.js",
    "start:web": "next start --hostname 0.0.0.0 --port 3000",
    "start:worker": "node build/server/worker.js",
    "start:scheduler": "node build/server/scheduler.js",
    "db:generate": "drizzle-kit generate",
    "db:check": "drizzle-kit check",
    "db:migrate": "tsx src/server/db/migrate.ts",
    "db:migrate:prod": "node build/server/db/migrate.js",
    "typecheck:server": "tsc -p tsconfig.server.json --noEmit",
    "typecheck": "npm run typecheck:server && tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run src app --exclude src/server/db/postgres.integration.test.ts --exclude src/server/redis.integration.test.ts",
    "test:postgres": "vitest run src/server/db/postgres.integration.test.ts",
    "test:redis": "vitest run src/server/rate-limits.integration.test.ts src/server/redis.integration.test.ts",
    "qualify:postgres-upgrade": "node scripts/qualify-postgres-upgrade.mjs",
    "qualify:distributed": "node scripts/qualify-distributed.mjs",
    "qualify:stripe": "node scripts/qualify-stripe.mjs",
    "qualify:email": "node scripts/qualify-email.mjs",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "argon2": "^0.45.1",
    "bullmq": "^6.3.11",
    "cheerio": "^1.2.0",
    "connect-pg-simple": "^10.0.0",
    "dotenv": "^18.0.6",
    "drizzle-orm": "^0.45.3",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.1",
    "express-session": "^1.19.0",
    "helmet": "^8.3.0",
    "ioredis": "^6.0.0",
    "ipaddr.js": "^2.5.0",
    "lucide-react": "^0.468.0",
    "next": "^15.5.27",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "resend": "^6.32.1",
    "stripe": "^23.0.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.0",
    "@types/connect-pg-simple": "^7.0.3",
    "@types/express": "^5.0.6",
    "@types/express-session": "^1.19.0",
    "@types/node": "^26.6.4",
    "@types/pg": "^8.23.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "drizzle-kit": "^0.31.11",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "prettier": "^3.9.9",
    "tsx": "^4.23.15",
    "typescript": "~5.6.3",
    "typescript-eslint": "^8.71.1",
    "vitest": "^5.0.3"
  },
  "overrides": {
    "postcss": "^8.5.29",
    "@esbuild-kit/core-utils": {
      "esbuild": "^0.25.12"
    }
  }
}
