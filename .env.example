# Local host-process defaults for `npm run dev:stack` only.
# Do not use this file for production Docker Compose or production data.
NODE_ENV=development
PORT=4000
DATABASE_URL=postgres://wcm:wcm@127.0.0.1:5432/wcm
REDIS_URL=redis://127.0.0.1:6379
SESSION_SECRET=replace-with-a-random-32-byte-or-longer-secret-before-deployment
APP_ORIGIN=http://localhost:3000
APP_BASE_URL=http://localhost:3000
SESSION_TTL_HOURS=168
# Optional bearer token for the Prometheus metrics endpoint (minimum 24 characters).
# METRICS_TOKEN=generate-a-separate-random-token-for-metrics
WORKER_CONCURRENCY=4
SCHEDULER_INTERVAL_MS=10000
FETCH_TIMEOUT_MS=15000
FETCH_MAX_REDIRECTS=5
FETCH_DOMAIN_COOLDOWN_MS=1000
MAX_FETCH_BYTES=2000000
ALLOW_DEV_VERIFICATION_TOKEN=true
# Set true at production image build time when HTTPS is enabled at the public edge.
ENABLE_HSTS=false
RESEND_API_KEY=
EMAIL_FROM=alerts@example.com
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_BUSINESS=
